#!/bin/sh
# MP/M II + CP/NET server launcher.
# Uses `cp` (not `ln`) so CCP's one-shot $$$.SUB deletion doesn't
# mutate the pristine library copies.
#
# Drive map (matches the CP/NOS slave's default CFGTBL so A/B/C on the
# slave address the same letters on the master):
#   A: mpm-net2-1  MP/M boot + CPNOS.IMG + common MP/M tools
#   B: cpm22-1     Assemblers + linkers: ASM, MAC, RMAC, M80, L80, LINK,
#                  Z80ASM, SLRNK, DDT, SID, STAT, PIP, CREF80
#   C: cpm22-2     Sources: BIOS.Z80, BOOT.Z80, SURVEY.MAC, W.ASM,
#                  CLS.MAC, BYE.ASM, SPEED.C
#   D: cpnetsmk   fresh disk containing SUMTEST.ASM (the cpnet-smoke
#                  test source; regenerated by cpnos-rom/testutil/
#                  mksmokedisk.sh).  Falls back to mpm-net2-2 if the
#                  smoke disk hasn't been built yet.
#   I: 4 MB HD    master harddisk #1 (cpmsim drive #8).  Slave maps E:->I:
#                  in cpnos-rom/cfgtbl.c so the slave sees a 4 MB drive
#                  for builds/spool that don't fit on a 256 KB floppy.
#   J: 4 MB HD    master harddisk #2 (cpmsim drive #9).  Slave maps F:->J:
#                  for a second large scratch drive.
#                  If the library disks are missing, the launcher falls
#                  back to creating blank ones via z80pack mkdskimg.
#
# From a CP/NOS slave at A>:
#   B:DIR              (list tools)
#   C:DIR              (list sources)
#   B:MAC C:SURVEY.MAC (assemble master C:SURVEY.MAC using B:MAC)
#   B:M80 C:SURVEY,=C:SURVEY

rm -f disks/drive[a-d].dsk disks/drive[ij].dsk
# Boot disk: disks/local/mpm-net2-1.dsk is REQUIRED.  This is the
# patched MPM.SYS image produced by
# cpnet-z80/dist/mpm/rebuild-mpm-sys.sh --install (or any other
# locally-prepared copy).  Refusing to fall back to the pristine
# library disk is deliberate — that fallback silently masked the
# case where the rebuild had never been run / had failed (see
# 2026-06-11 session notes), and an out-of-the-box library disk
# doesn't carry the project's SERVER.RSP changes (gettod / FN 105)
# so anything that relies on them would silently misbehave.
if [ ! -f disks/local/mpm-net2-1.dsk ]; then
    cat >&2 <<'EOM'
mpm-net2: disks/local/mpm-net2-1.dsk is missing.

This launcher requires a locally-built boot disk.  Build one with:

    cd ../../cpnet-z80/dist/mpm && ./rebuild-mpm-sys.sh --install

(That regenerates MPM.SYS via vcpm-hosted GENSYS, packing the
current SERVER.RSP source, and lands the patched disk in
disks/local/mpm-net2-1.dsk.)

The pristine z80pack disks/library/mpm-net2-1.dsk is intentionally
NOT used as a fallback — see cpnet/REBUILDING_MPM_SYS.md.
EOM
    exit 1
fi
cp disks/local/mpm-net2-1.dsk disks/drivea.dsk
cp disks/library/cpm22-1.dsk    disks/driveb.dsk
cp disks/library/cpm22-2.dsk    disks/drivec.dsk
cp disks/library/mpm-net2-2.dsk disks/drived.dsk

# 4 MB hard disks for slave E:/F:.  If the pristine library copies are
# missing, fall back to a blank E5-filled image (mkdskimg) so the launch
# doesn't fail on a fresh checkout.
for hd in i j; do
    src=disks/library/mpm-net2-drive$hd.dsk
    dst=disks/drive$hd.dsk
    if [ -f "$src" ]; then
        cp "$src" "$dst"
    else
        echo "mpm-net2: $src missing, creating blank 4 MB image at $dst" >&2
        rm -f "$dst"
        ./srctools/mkdskimg $hd
    fi
done
exec ./cpmsim
